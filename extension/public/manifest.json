{
  "manifest_version": 3,
  "name": "TrackDown",
  "version": "0.1.0",
  "description": "Identify the background song playing in any browser tab.",

  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "activeTab"
  ],

  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "TrackDown — identify this song"
  }
}
