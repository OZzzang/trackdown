# Copy to server/.env and fill in. Never commit the real .env.

# Which fingerprinting provider to use: audd (development) or acrcloud (production).
# See docs/DECISIONS.md — AudD is free to develop against, ACRCloud is more accurate.
# `acr` is accepted as an alias for acrcloud, because scratch/batch.sh uses that spelling.
# Unset defaults to audd. An unrecognized value refuses to boot rather than 500ing later.
PROVIDER=audd

# AudD — https://audd.io. Free tier, bearer token.
AUDD_TOKEN=

# ACRCloud — https://acrcloud.com. Paid ($50 minimum). Only needed for production
# and for re-running the provider comparison in scratch/.
ACR_HOST=
ACR_ACCESS_KEY=
ACR_ACCESS_SECRET=

# Spotify Client Credentials (Phase 2, required before PROVIDER=acrcloud goes live).
# ACRCloud returns no artwork, so cover art has to be fetched server-side from the Spotify
# track ID it does return. Without these the popup ships with no album art.
# https://developer.spotify.com/dashboard — this is the client-credentials flow, unrelated
# to the user-facing OAuth in Phase 4.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# MongoDB Atlas connection string (Phase 3+)
MONGODB_URI=

# Set to 1 ONLY when deployed behind a proxy (Railway/Render), so the rate limiter reads
# the real client IP from X-Forwarded-For. Leaving it on locally lets anyone forge an IP
# and bypass rate limiting entirely.
TRUST_PROXY=

# Express port
PORT=3000
