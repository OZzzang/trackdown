# Copy to server/.env and fill in. Never commit the real .env.

# Which fingerprinting provider to use: acrcloud or audd. See docs/DECISIONS.md.
# `acr` is accepted as an alias for acrcloud, because scratch/batch.sh uses that spelling.
# Unset defaults to acrcloud. An unrecognized value refuses to boot rather than 500ing later.
PROVIDER=acrcloud

# ACRCloud — https://acrcloud.com. Paid ($50 minimum). Used in production and, since
# 2026-08-08 when the AudD trial ran out, in development too.
ACR_HOST=
ACR_ACCESS_KEY=
ACR_ACCESS_SECRET=

# AudD — https://audd.io. Free tier, bearer token. Still selectable with PROVIDER=audd, and
# a fresh clone with an unused trial can develop against it, but it is no longer the default.
AUDD_TOKEN=

# Cover art needs no credentials. ACRCloud returns none, so it is filled server-side from
# the iTunes Search API, which is public and unauthenticated — see docs/DECISIONS.md for why
# that beat Spotify (whose Web API now requires the app owner to hold Premium).

# MongoDB Atlas connection string (Phase 3+)
MONGODB_URI=

# Global cap on provider calls per UTC day, across every caller. This is what bounds the
# bill: the per-IP limits stop one scraper, not a hundred. Unset defaults to 500. Set it to 0
# to refuse every identification, which is the fastest way to take the service down without
# taking the server down.
DAILY_IDENTIFY_BUDGET=

# Set to 1 ONLY when deployed behind a proxy (Railway/Render), so the rate limiter reads
# the real client IP from X-Forwarded-For. Leaving it on locally lets anyone forge an IP
# and bypass rate limiting entirely.
TRUST_PROXY=

# Comma-separated extension IDs, bare, with no chrome-extension:// scheme. Unset allows every
# origin — the right default for development, and announced at boot so an open production
# instance shows up in the logs instead of staying quiet. Set it to the published ID once the
# Web Store issues one. Belt-and-braces rather than load-bearing: an extension page fetching a
# host listed in its own host_permissions is not subject to CORS in the first place, so this
# governs curl and other non-extension callers.
ALLOWED_EXTENSION_IDS=

# Express port
PORT=3000
